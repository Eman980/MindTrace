# MindTrace Production & Research Environment Configuration
PROJECT_NAME="MindTrace"
PROJECT_TAGLINE="Understand What You Understand"
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL="sqlite:///./mindtrace.db"

# Security & Authentication
SECRET_KEY="replace-with-a-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Delivery Configuration (Optional - for Password Reset)
# If left blank, password reset tokens are logged to the backend console for local testing.
SMTP_SERVER=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@mindtrace.edu"
SMTP_TLS=1
FRONTEND_URL="http://localhost:5173"

# External AI APIs (Optional: Set your OpenAI API key for real Whisper STT & GPT-4o-mini generation)
# If empty, MindTrace automatically uses its built-in pedagogical domain engine without errors.
OPENAI_API_KEY=""

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=250

# Behavioural Tracking & Severity
REPLAY_THRESHOLD=3

# Evidence-Based Resolution State Machine Thresholds (Configurable for E4 Evaluation)
N_PASS=2
MIN_DELAY_HOURS=72
DEMO_DELAY_HOURS=1
CONFIDENCE_FLOOR=2
USE_DEMO_DELAY=0
